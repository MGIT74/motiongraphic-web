---
const title = 'MotionGraphic.si — Le Studio créatif propulsé par l’IA';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="MotionGraphic.si : créez des animations professionnelles avec l’IA, ChatGPT et Claude via MCP. Découvrez le futur Studio." />
  <link rel="canonical" href="https://motiongraphic.si/" />
  <title>{title}</title>
  <style>
    :root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#17233b;background:#fff;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 44%,#eaf4ff 0%,#fff 55%)}a{color:inherit;text-decoration:none}.container{max-width:1140px;margin:auto;padding:0 26px}header{height:92px;display:flex;align-items:center;justify-content:space-between}.logo{font-size:20px;font-weight:800;letter-spacing:-.8px}.logo span{color:#007aff}.header-link{font-size:13px;color:#58677e}.header-link:hover{color:#007aff}main{text-align:center}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid #cfe5ff;background:#f2f8ff;border-radius:30px;padding:9px 16px;color:#0875dc;font-size:12px;font-weight:650;margin:24px 0 20px}.dot{width:7px;height:7px;border-radius:50%;background:#007aff;box-shadow:0 0 0 4px #d7eaff}h1{font-size:clamp(36px,5.8vw,66px);letter-spacing:-3px;line-height:1.09;margin:0 auto 20px;max-width:880px;font-weight:800}h1 em{font-style:normal;color:#007aff}.lead{font-size:clamp(15px,1.7vw,19px);color:#64748b;line-height:1.65;margin:0 auto 42px;max-width:650px}.stage{border:1px solid #d9e7f7;background:linear-gradient(135deg,#fff,#f8fbff);border-radius:30px;box-shadow:0 28px 85px #2677c21c,0 2px 10px #0a37620c;padding:28px;display:grid;grid-template-columns:1fr 100px 1.45fr;align-items:center;gap:14px;text-align:left;min-height:330px}.connectors{display:grid;gap:15px}.ai-card{display:flex;align-items:center;gap:13px;padding:17px 19px;background:#fff;border:1px solid #e4eaf2;border-radius:17px;box-shadow:0 5px 18px #0a376208;font-weight:700}.ai-logo{width:36px;height:36px;display:grid;place-items:center;border-radius:11px;background:#edf6ff;color:#007aff;font-size:17px}.ai-card small{display:block;color:#8b97aa;font-weight:400;margin-top:4px}.mcp{position:relative;display:grid;place-items:center;gap:8px;color:#007aff;font-weight:800;font-size:13px}.mcp:before,.mcp:after{content:'';width:40px;height:2px;background:linear-gradient(90deg,#bcdcff,#007aff);position:absolute;top:38%;left:-12px}.mcp:after{left:auto;right:-12px}.hub{width:68px;height:68px;display:grid;place-items:center;background:#007aff;color:white;border-radius:20px;box-shadow:0 12px 25px #007aff3b;font-size:15px}.editor{background:#0b1222;border:1px solid #202e49;border-radius:19px;overflow:hidden;color:white;box-shadow:0 20px 40px #0b12222a}.editor-top{height:43px;border-bottom:1px solid #243047;display:flex;align-items:center;gap:7px;padding:0 15px;font-size:11px;color:#95a4bb}.light{height:7px;width:7px;border-radius:50%;background:#ff6961}.light:nth-child(2){background:#ffcb4e}.light:nth-child(3){background:#34c759}.editor-top strong{margin-left:12px;font-weight:500}.preview{height:174px;display:grid;place-items:center;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 90%,#103b78,#0b1222 65%)}.motion-shape{height:105px;width:160px;border:4px solid #299bff;border-radius:40% 60% 55% 45%;filter:drop-shadow(0 0 20px #007aff);animation:float 5s ease-in-out infinite;transform:rotate(-20deg)}.motion-shape:after{content:'';display:block;width:110px;height:65px;border:2px solid #67bdff;border-radius:55% 45% 60% 40%;transform:translate(20px,15px)}.preview-label{position:absolute;bottom:12px;left:16px;font-size:11px;color:#9cb4d5}.timeline{height:60px;border-top:1px solid #243047;padding:14px;display:grid;gap:7px}.track{height:8px;background:linear-gradient(90deg,#1a77d5 0 65%,#22314c 65%);border-radius:4px}.track:nth-child(2){background:linear-gradient(90deg,#7f62df 0 42%,#22314c 42%)}@keyframes float{50%{transform:rotate(18deg) translateY(-13px) scale(1.07)}}.typing{min-height:29px;font-size:17px;margin:33px auto 12px;font-weight:600;color:#394861}.typing b{color:#007aff}.cursor{display:inline-block;width:2px;height:20px;background:#007aff;vertical-align:-4px;margin-left:4px;animation:blink .8s steps(1) infinite}@keyframes blink{50%{opacity:0}}.features{display:flex;flex-wrap:wrap;justify-content:center;gap:13px 24px;color:#708096;font-size:13px;margin:18px 0 40px}.features span:before{content:'✓';color:#007aff;margin-right:7px}.signup{max-width:650px;margin:0 auto 65px;padding:30px;border:1px solid #e3ecf7;background:#fff;border-radius:24px;box-shadow:0 15px 50px #166cc70c}.signup h2{font-size:24px;letter-spacing:-.7px;margin:0 0 9px}.signup p{color:#708096;font-size:14px;margin:0 0 20px;line-height:1.5}.form-row{display:flex;gap:9px}.form-row input{flex:1;min-width:0;padding:15px 17px;border:1px solid #d9e3ee;border-radius:12px;font:inherit;font-size:14px;outline:none}.form-row input:focus{border-color:#007aff;box-shadow:0 0 0 3px #007aff1c}.form-row button,.cta{background:#007aff;color:#fff;border:0;border-radius:12px;padding:15px 21px;font:inherit;font-size:14px;font-weight:650;cursor:pointer}.form-row button:hover,.cta:hover{background:#0069dd}.fineprint{font-size:11px!important;color:#9ca8b7!important;margin:12px 0 0!important}footer{border-top:1px solid #e9eff6;padding:25px 0 30px;display:flex;justify-content:space-between;gap:15px;color:#9aa7b7;font-size:12px}footer a:hover{color:#007aff}@media(max-width:760px){header{height:75px}h1{letter-spacing:-1.8px}.stage{grid-template-columns:1fr;padding:17px;gap:22px}.connectors{grid-template-columns:1fr 1fr;gap:9px}.ai-card{padding:12px;gap:8px;font-size:12px}.ai-logo{width:30px;height:30px}.ai-card small{font-size:10px}.mcp{min-height:60px}.mcp:before,.mcp:after{display:none}.editor{max-width:100%}.form-row{flex-direction:column}.typing{font-size:14px}.signup{padding:24px 18px}footer{flex-direction:column;text-align:center}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
<div class="container">
<header><a class="logo" href="/" aria-label="MotionGraphic.si, accueil">motiongraphic<span>.si</span></a><a class="header-link" href="https://studio.motiongraphic.si" rel="noopener noreferrer">Accéder au Studio ↗</a></header>
<main>
  <div class="eyebrow"><span class="dot"></span> Studio en construction · Bêta bientôt disponible</div>
  <h1>Le nouveau Studio <br/>MotionGraphic.si <em>arrive bientôt.</em></h1>
  <p class="lead">Donnez vie à vos idées. Créez des animations professionnelles avec l’intelligence artificielle, directement dans votre navigateur.</p>
  <section class="stage" aria-label="ChatGPT et Claude connectés au Studio MotionGraphic via MCP">
    <div class="connectors"><div class="ai-card"><div class="ai-logo">✳</div><div>ChatGPT<small>Assistant créatif IA</small></div></div><div class="ai-card"><div class="ai-logo">✦</div><div>Claude<small>Assistant créatif IA</small></div></div></div>
    <div class="mcp"><div class="hub">MCP</div><span>Connecté</span></div>
    <div class="editor"><div class="editor-top"><span class="light"></span><span class="light"></span><span class="light"></span><strong>MotionGraphic Studio — Aperçu</strong></div><div class="preview"><div class="motion-shape"></div><span class="preview-label">Animation générée · Preview</span></div><div class="timeline"><div class="track"></div><div class="track"></div></div></div>
  </section>
  <p class="typing" aria-live="off"><span id="typed">ChatGPT et Claude se connectent via MCP</span><span class="cursor" aria-hidden="true"></span></p>
  <div class="features"><span>Animations assistées par IA</span><span>Éditeur de motion</span><span>Export MP4</span><span>Créativité sans limites</span></div>
  <section class="signup" id="beta"><h2>Accédez à la version bêta du Studio</h2><p>Rejoignez la liste d’attente pour être informé de l’ouverture.</p><form id="beta-form"><div class="form-row"><input type="email" id="email" name="email" placeholder="Votre adresse e-mail" autocomplete="email" required aria-label="Votre adresse e-mail"/><button type="submit">S’inscrire à la bêta</button></div><p id="form-status" role="status" class="fineprint">Les inscriptions seront bientôt disponibles.</p></form></section>
</main>
<footer><span>© {new Date().getFullYear()} MotionGraphic.si</span><span>Studio créatif propulsé par l’IA</span></footer>
</div>
<script>
const phrases=['ChatGPT et Claude se connectent via MCP','Transformez une idée en animation','Créez des motions professionnels avec l’IA','Imaginez. Animez. Exportez.'];
const target=document.getElementById('typed');let phrase=0,index=0,deleting=false;
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion&&target){function tick(){const current=phrases[phrase];index+=deleting?-1:1;target.textContent=current.slice(0,index);let delay=deleting?35:70;if(!deleting&&index===current.length){deleting=true;delay=1700}else if(deleting&&index===0){deleting=false;phrase=(phrase+1)%phrases.length;delay=400}window.setTimeout(tick,delay)}window.setTimeout(tick,1300)}
const form=document.getElementById('beta-form');form?.addEventListener('submit',(event)=>{event.preventDefault();const status=document.getElementById('form-status');if(status)status.textContent='Les inscriptions ne sont pas encore ouvertes. Le formulaire sera activé après la connexion sécurisée à Supabase.'});
</script>
</body></html>
