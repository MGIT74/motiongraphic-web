---
const title = 'motiongraphic.si';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="MotionGraphic Studio — création de motion design et animations." />
  <meta name="google-site-verification" content="LBziX14j7lOQmrZEKpHo3xPZkY8ev9bZ2KCzR3pVdLo" />
  <link rel="canonical" href="https://motiongraphic.si/" />
  <title>{title}</title>
  <style>
    :root { color-scheme: light; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: #fff; }
    body { min-height: 100svh; display: grid; place-items: center; padding: 24px; }
    main { display: flex; align-items: center; justify-content: center; max-width: 100%; }
    h1 { display: flex; align-items: center; margin: 0; font-size: clamp(28px, 5.2vw, 68px); font-weight: 800; line-height: 1.15; letter-spacing: -.055em; color: #080808; white-space: nowrap; }
    #word { display: inline-block; }
    .cursor { display: inline-block; width: 3px; height: .92em; margin-left: 5px; background: #007aff; animation: blink .85s steps(1, end) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  </style>
</head>
<body>
  <main>
    <h1 aria-label="motiongraphic.si"><span id="word">motiongraphic.si</span><span class="cursor" aria-hidden="true"></span></h1>
  </main>
  <script>
    const word = document.getElementById('word');
    const text = 'motiongraphic.si';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (word && !reduced) {
      let length = text.length;
      let deleting = true;
      function type() {
        if (deleting) {
          length = Math.max(0, length - 1);
          word.textContent = text.slice(0, length);
          if (length === 0) {
            deleting = false;
            window.setTimeout(type, 450);
            return;
          }
          window.setTimeout(type, 65);
        } else {
          length = Math.min(text.length, length + 1);
          word.textContent = text.slice(0, length);
          if (length === text.length) {
            deleting = true;
            window.setTimeout(type, 3200);
            return;
          }
          window.setTimeout(type, 105);
        }
      }
      window.setTimeout(type, 3500);
    }
  </script>
</body>
</html>
