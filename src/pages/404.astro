---
const title = '404 — motiongraphic.si';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <style>
    :root { color-scheme: light; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: #fff; }
    body { min-height: 100svh; padding: 28px clamp(22px, 6vw, 96px); }
    header a { color: #050505; text-decoration: none; font-size: clamp(17px, 2vw, 24px); font-weight: 800; letter-spacing: -.055em; }
    main { min-height: calc(100svh - 110px); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding-bottom: 70px; }
    h1 { font-size: clamp(100px, 16vw, 190px); letter-spacing: -.085em; line-height: 1; font-weight: 800; color: #050505; margin: 0 0 24px; display: flex; align-items: center; }
    .cursor { width: clamp(4px, .5vw, 7px); height: .79em; background: #007aff; margin-left: 13px; animation: blink .85s steps(1) infinite; }
    h2 { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: clamp(22px, 3.3vw, 40px); font-weight: 500; letter-spacing: -.04em; margin: 0 0 20px; color: #111; }
    p { margin: 0 0 48px; color: #64748b; font-size: clamp(15px, 1.5vw, 20px); line-height: 1.6; }
    .back { display: inline-flex; align-items: center; gap: 13px; background: #080808; color: white; padding: 17px 26px; border-radius: 999px; text-decoration: none; font-weight: 650; font-size: 16px; transition: transform .2s, background .2s; }
    .back:hover { background: #242424; transform: translateY(-2px); }
    .back:focus-visible { outline: 3px solid #007aff; outline-offset: 4px; }
    .back svg { width: 20px; height: 20px; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } .back { transition: none; } }
  </style>
</head>
<body>
  <header><a href="/" aria-label="Retour à l'accueil motiongraphic.si">motiongraphic.si</a></header>
  <main>
    <h1>404<span class="cursor" aria-hidden="true"></span></h1>
    <h2>Page introuvable...</h2>
    <p>La page que vous recherchez n’existe pas ou a été déplacée.</p>
    <a class="back" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9"/><path d="M9 21v-8h6v8"/></svg>
      Retour à l’accueil
    </a>
  </main>
</body>
</html>
